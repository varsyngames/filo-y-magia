<script>
// UTILIDADES. Números siempre enteros; los muy grandes se abrevian.
function fmtN(v){v=Math.round(Number(v)||0);const a=Math.abs(v);
 if(a>=1e9)return v.toExponential(2).replace('.',',').replace('e+','e');
 if(a>=1e6)return (v/1e6).toFixed(2).replace('.',',')+' M';
 return v.toLocaleString('es')}
function multXP(l){for(const t of XP.tramos)if(l<=t.hasta)return t.mult;return 1.04}
// Gasta oro. En modo debug con "oro infinito" no descuenta nada.
function gastar(c){if(!(DEBUG&&DBG.oroInf))ACC.oro-=c}

</script>
<script>
// SISTEMA DE EVENTOS. Las pasivas futuras se enganchan aquí: Eventos.on('golpe', datos => {...}).
// Eventos disponibles y sus datos:
//   golpe {enemigo, dano, fuente}        muerte {enemigo}          esquiva {}
//   dano_recibido {cantidad, fuego}      subida_nivel {nivel}      recogida {tipo, valor}
//   inicio_partida {mapa}                fin_partida {resultado: 'victoria'|'derrota'|'abandono'}
const Eventos={_f:{},contadores:{},
 on(ev,fn){(this._f[ev]=this._f[ev]||[]).push(fn);return ()=>this.off(ev,fn)},
 off(ev,fn){this._f[ev]=(this._f[ev]||[]).filter(f=>f!==fn)},
 emit(ev,datos){this.contadores[ev]=(this.contadores[ev]||0)+1;const l=this._f[ev];
  if(l)for(const f of l){try{f(datos||{})}catch(e){console.error('Evento '+ev,e)}}}};

</script>
<script>
// GUARDADO con versión. Claves con prefijo propio 'fym_'. Un perfil independiente por modo (facil / dificil).
// El modo debug usa su propia clave ('fym_debug'), así que nunca toca el guardado real.
const GUARDADO_VERSION=2;
const CLAVE=DEBUG?'fym_debug':'fym_guardado',CLAVE_REAL='fym_guardado',CLAVE_ANTIGUA='kh_acc';
let MODO='facil';
function perfilVacio(){return{oro:0,up:{},own:{},eq:[],ns:1,rr:0,bn:0,keys:['cadena'],mags:['fuego'],nivelPersonaje:1,xpPersonaje:0,materiales:{}}}
function ent(x,d){x=Math.floor(Number(x));return isFinite(x)&&x>=0?x:d}
function sanear(p){p=Object.assign(perfilVacio(),p||{});
 p.oro=ent(p.oro,0);p.ns=Math.max(1,Math.min(LIM.huecos,ent(p.ns,1)));p.rr=Math.min(LIM.rerolls,ent(p.rr,0));p.bn=Math.min(LIM.desterrar,ent(p.bn,0));
 p.nivelPersonaje=Math.max(1,ent(p.nivelPersonaje,1));p.xpPersonaje=ent(p.xpPersonaje,0);
 if(!Array.isArray(p.eq))p.eq=[];p.eq=p.eq.map(x=>ITEMS[x]?x:null);
 if(!Array.isArray(p.keys)||!p.keys.length)p.keys=['cadena'];
 if(!Array.isArray(p.mags)||!p.mags.length)p.mags=['fuego'];
 p.mags=p.mags.map(m=>m=='piro'?'fuego':m);          // Piro pasó a llamarse Fuego
 if(typeof p.up!='object'||!p.up)p.up={};if(typeof p.own!='object'||!p.own)p.own={};if(typeof p.materiales!='object'||!p.materiales)p.materiales={};
 return p}
// v2: se añade 'ajustes' (apuntado). Para versiones futuras: añade aquí 'if(v<3){...}' y sube GUARDADO_VERSION.
function migrar(g){const v=g.version||0;if(v<2)g.ajustes={apuntado:'auto'};g.ajustes=Object.assign({apuntado:'auto'},g.ajustes);if(g.ajustes.apuntado!='manual')g.ajustes.apuntado='auto';g.version=GUARDADO_VERSION;g.modos=g.modos||{};
 for(const m of ['facil','dificil'])g.modos[m]=sanear(g.modos[m]);return g}
function desdeAntiguo(o){return{version:0,modos:{facil:{oro:o.plat,up:o.up,own:o.own,eq:o.eq,ns:o.ns,rr:o.rr,bn:o.bn,keys:o.keys,mags:o.mags}}}}
function leer(k){try{const r=localStorage.getItem(k);return r?JSON.parse(r):null}catch(e){return null}}
function cargarGuardado(){let g=leer(CLAVE);if(g)return migrar(g);
 if(DEBUG){g=leer(CLAVE_REAL);if(g)return migrar(g)}
 const o=leer(CLAVE_ANTIGUA);if(o)return migrar(desdeAntiguo(o));
 return migrar({})}
let GUARDADO_OK=true;
try{localStorage.setItem('fym_prueba','1');GUARDADO_OK=localStorage.getItem('fym_prueba')==='1';localStorage.removeItem('fym_prueba')}catch(e){GUARDADO_OK=false}
let SAVE=cargarGuardado(),ACC=SAVE.modos[MODO];     // ACC = perfil del modo activo
function saveAcc(){try{localStorage.setItem(CLAVE,JSON.stringify(SAVE))}catch(e){GUARDADO_OK=false}}

</script>
<script>
// MODO DEBUG: añade ?debug a la dirección. Usa un perfil aparte ('fym_debug'). En partida, la tecla B salta al jefe.
const DBG={oroInf:false};
function debugMenu(){
 showOv('<h2>Debug</h2><div class="row">'+MAPAS.map((m,i)=>'<button onclick="startRun('+i+')">Mapa: '+m.n+'</button>').join('')+'</div>'
 +'<p>Oro: '+fmtN(ACC.oro)+' · Nivel de personaje: '+ACC.nivelPersonaje+'</p>'
 +'<div class="row"><button onclick="dbgTodo()">Desbloquear todo</button><button onclick="dbgOro()">+1.000.000 de oro</button><button onclick="dbgInf()">Oro infinito: '+(DBG.oroInf?'sí':'no')+'</button></div>'
 +'<div class="row"><input id="dbgNiv" type="number" min="1" value="'+ACC.nivelPersonaje+'" style="font:inherit;width:9ch"><button onclick="dbgNiv()">Fijar nivel de personaje</button><button onclick="dbgNivRap(50)">50</button><button onclick="dbgNivRap(100)">100</button><button onclick="dbgNivRap(500)">500</button></div>'
 +'<p style="font-size:13px">Eventos: '+Object.entries(Eventos.contadores).map(([k,v])=>k+' '+fmtN(v)).join(' · ')+'</p>'
 +'<div class="row"><button onclick="dbgReset()">Reiniciar perfil debug</button><button onclick="menu()">Volver</button></div>')}
function dbgTodo(){ACC.keys=FAMS.map(f=>f.id);ACC.mags=MAGS.slice();for(const k in ITEMS)ACC.own[k]=1;for(const k in UPS)ACC.up[k]=NIVEL_MAX;ACC.ns=LIM.huecos;ACC.rr=LIM.rerolls;ACC.bn=LIM.desterrar;saveAcc();debugMenu()}
function dbgOro(){ACC.oro+=1000000;saveAcc();debugMenu()}
function dbgInf(){DBG.oroInf=!DBG.oroInf;if(DBG.oroInf)ACC.oro=Math.max(ACC.oro,1e12);saveAcc();debugMenu()}
function dbgNiv(){ACC.nivelPersonaje=Math.max(1,ent(document.getElementById('dbgNiv').value,1));saveAcc();debugMenu()}
function dbgNivRap(n){ACC.nivelPersonaje=n;saveAcc();debugMenu()}
function dbgReset(){SAVE=migrar({});ACC=SAVE.modos[MODO];saveAcc();debugMenu()}

</script>
<script>
// ARMAS Y ENEMIGOS CON LÓGICA PROPIA: Trueno, Bastón (rotación fuego / hielo / rayo), muros de hielo, Fulminante y programador de acciones.
function progr(t,fn){S.sch.push({t,fn})}               // ejecuta fn dentro de t segundos
function stunE(e,d){if(e.ty=='part'||d<=0)return;e.stun=Math.max(e.stun||0,d)}   // los jefes son inmunes
// ---- Trueno: un rayo cae cerca de un enemigo al azar dentro de medio campo de visión (ignora la dirección de apuntado)
function truD(){return(1+.03*cnt('dano'))*(1+S.a.mag+pm())*(1+.15*cnt('trueno_dmg'))*np('trueno')}
function stunDur(){return(cnt('trueno')>=3?.5:0)+.25*cnt('trueno_stun')}
function rayoAt(p){const R=42*(1+.15*cnt('trueno_area')),hi=cnt('trueno'),dm=(18+5*hi)*truD();
 S.fx.push({k:'bolt',x:p.x,y:p.y,R,t:.3,m:.3});
 for(const e of S.en)if(e.hp>0&&Math.hypot(e.x-p.x,e.y-p.y)<R+e.r){hurt(e,dm,'Trueno');if(hi>=3)stunE(e,stunDur())}}
function enlace(a,b){const dm=.6*(18+5*cnt('trueno'))*truD(),dx=b.x-a.x,dy=b.y-a.y,l2=dx*dx+dy*dy||1;
 S.fx.push({k:'link',x:a.x,y:a.y,x2:b.x,y2:b.y,t:.4,m:.4});
 for(const e of S.en){if(e.hp<=0)continue;const u=Math.max(0,Math.min(1,((e.x-a.x)*dx+(e.y-a.y)*dy)/l2));
  if(Math.hypot(e.x-(a.x+u*dx),e.y-(a.y+u*dy))<16+e.r){hurt(e,dm,'Trueno');stunE(e,stunDur())}}}
function truenoUpd(dt,AS){P.tc=(P.tc||0)-dt;if(P.tc>0)return;
 const R=Math.min(W,H)/2,cand=S.en.filter(e=>e.hp>0&&Math.hypot(e.x-P.x,e.y-P.y)<R);if(!cand.length)return;
 P.tc=2.2*Math.pow(.9,cnt('trueno_freq'))/AS;
 const t=cand[Math.floor(Math.random()*cand.length)],pts=[{x:t.x+(Math.random()-.5)*40,y:t.y+(Math.random()-.5)*40}];
 if(cnt('trueno')>=5){const cerca=S.en.filter(e=>e!==t&&e.hp>0&&Math.hypot(e.x-t.x,e.y-t.y)<170);if(cerca.length){const q=cerca[Math.floor(Math.random()*cerca.length)];pts.push({x:q.x,y:q.y})}}
 for(let i=0;i<=cnt('trueno_replica');i++)progr(i*.14,()=>{for(const p of pts)rayoAt(p);if(pts.length==2)enlace(pts[0],pts[1])})}
// Pulso electromagnético: un anillo que sale del jugador a 2200 px/s (cruza el mapa en ~2 s) y aturde a cada enemigo que alcanza.
function pulsoEM(){S.pulsos.push({x:P.x,y:P.y,r:0,h:new Set()})}
// Rayo de jefe con aviso: un destello blanco marca el punto y el rayo cae 'aviso' segundos después.
function avisoRayo(x,y,c){x=Math.max(-AR.w+30,Math.min(AR.w-30,x));y=Math.max(-AR.h+30,Math.min(AR.h-30,y));const q={x,y,t:c.aviso,m:c.aviso,R:c.radio};S.av.push(q);
 progr(c.aviso,()=>{S.av=S.av.filter(z=>z!==q);S.fx.push({k:'bolt',x,y,R:c.radio,t:.35,m:.35});if(P.inv<=0&&Math.hypot(P.x-x,P.y-y)<c.radio+10)hitP(c.dano)})}
// Jefe 'bruto': solo persigue (la furia lo acelera).
function brutoUpd(e,dt,a){const rg=rage();to(e,P.x,P.y,Math.min(S.jefe.velTope,S.jefe.vel*rg),dt)}
// ---- Bastón: cada ataque rota fuego -> hielo -> rayo. Con 3 copias: lanzallamas, muro de hielo y rayo que rebota.
function dB(){const c=cnt('ur'),st=Math.max(0,c-3);return(12+3*Math.min(c,8))*(1+.03*cnt('dano'))*(1+S.a.mag+pm())*np('ur')*(1+.2*Math.ceil(st/2))*(1+.15*cnt('ur_dano'))}
function rA(){return 1+.15*cnt('ur_area')}
function bastonUpd(dt,AS){const c=cnt('ur'),ks=1+.15*Math.floor(Math.max(0,c-3)/2),B=P.bs=P.bs||{i:0,t:0,flame:0,ft:0};
 B.t-=dt;if(B.flame>0){B.flame-=dt;llamas(dt)}
 if(B.t>0)return;
 const a=aimA(300);if(a==null)return;P.fa=a;
 const step=1/ks/AS,leg=cnt('ur_leg'),els=leg?[0,1,2]:[B.i%3];if(!leg)B.i++;B.t=step;
 for(const el of els)lanzarB(el,a,c>=3,step)}
function lanzarB(el,a,mej,step){const n=1+cnt('ur_multi')+cnt('multig');
 if(el==2){S.sh.push({k:'bz',x:P.x,y:P.y,bx:P.x,by:P.y,a,t:0,rb:(mej?7:0)+cnt('ur_multi')+cnt('multig')});return}
 if(el==0&&mej){P.bs.flame=step;return}
 for(let i=0;i<n;i++){const aa=a+(i-(n-1)/2)*.2;S.sh.push({k:el==0?'bf':'bi',x:P.x,y:P.y,vx:Math.cos(aa)*340,vy:Math.sin(aa)*340,a:aa,t:0,mej})}}
function llamas(dt){const B=P.bs;B.ft-=dt;const a=aimA(170);if(a!=null)B.fa=a;else if(B.fa==null)B.fa=P.fa;P.fa=B.fa;
 if(B.ft>0)return;B.ft=.15;const R=115*rA(),dm=dB()*.35,tk=.3*dB();
 for(const e of S.en){if(e.hp<=0)continue;const dx=e.x-P.x,dy=e.y-P.y;if(Math.hypot(dx,dy)>R+e.r)continue;let d=Math.atan2(dy,dx)-B.fa;d=Math.atan2(Math.sin(d),Math.cos(d));
  if(Math.abs(d)<.5){hurt(e,dm,'Bastón');burn(e,'Bastón',tk)}}}
function golpeZ(e,d){hurt(e,d,'Bastón');stunE(e,.5)}
function cadenaZap(e0,rb,d){golpeZ(e0,d);if(rb<=0)return;const R=220*rA();
 if(!S.en.some(o=>o!==e0&&o.hp>0&&Math.hypot(o.x-e0.x,o.y-e0.y)<R)){hurt(e0,2*d,'Bastón');return}      // un solo objetivo: un golpe x3
 let cur=e0;for(let i=1;i<=rb;i++)progr(i*.07,()=>{let b=null,bd=R*R;for(const o of S.en){if(o===cur||o.hp<=0)continue;const q=(o.x-cur.x)**2+(o.y-cur.y)**2;if(q<bd){bd=q;b=o}}
  if(!b)return;S.fx.push({k:'link',x:cur.x,y:cur.y,x2:b.x,y2:b.y,t:.2,m:.2});golpeZ(b,d*.6);cur=b})}
function muro(x,y,a){const pa=a+Math.PI/2;for(const o of[-22,0,22])S.walls.push({x:x+Math.cos(pa)*o,y:y+Math.sin(pa)*o,r:16,t:5})}
function bastProj(s,dt){
 if(s.k=='bz'){s.bx+=Math.cos(s.a)*560*dt;s.by+=Math.sin(s.a)*560*dt;const off=Math.sin(s.t*34)*16;s.x=s.bx-Math.sin(s.a)*off;s.y=s.by+Math.cos(s.a)*off;if(s.t>.65){s.dead=1;return}}
 else{s.x+=s.vx*dt;s.y+=s.vy*dt;if(s.t>1.3){s.dead=1;return}}
 for(const e of S.en){if(e.hp<=0||Math.hypot(e.x-s.x,e.y-s.y)>=e.r+8)continue;const d=dB();
  if(s.k=='bz')cadenaZap(e,s.rb,d);
  else{const R=(s.k=='bf'?34:30)*rA();S.fx.push({k:'boom',x:s.x,y:s.y,R,t:.25,m:.25,hielo:s.k=='bi'});
   for(const o of S.en)if(o.hp>0&&Math.hypot(o.x-s.x,o.y-s.y)<R+o.r){hurt(o,d,'Bastón');if(s.k=='bf')burn(o,'Bastón',.3*d);else slow(o,.4,1.6)}
   if(s.k=='bi'&&s.mej)muro(s.x,s.y,s.a)}
  s.dead=1;break}}
// ---- Fulminante: al explotar daña al jugador y a todos los enemigos cercanos; lo que mata no suelta nada
function explotar(e){const R=ENEMIGOS[e.ty].ia.radio;S.fx.push({k:'boom',x:e.x,y:e.y,R,t:.35,m:.35,rojo:1});
 if(P.inv<=0&&Math.hypot(P.x-e.x,P.y-e.y)<R+10)hitP(e.ex);
 for(const o of S.en)if(o!==e&&o.hp>0&&Math.hypot(o.x-e.x,o.y-e.y)<R+o.r)hurt(o,e.ex*4,null,true);
 e.hp=0}
// ---- Arco: flechas rápidas (más cadencia que la Espada). Con 3 copias, Marca del cazador: UN enemigo marcado a la vez, 15 s, recibe más daño de todo.
const MARCA={dur:15,mult:1.35};
function arcoD(){const c=cnt('arco'),st=Math.max(0,c-3);return 14*(1+.03*cnt('dano'))*(1+S.a.phys+pp())*np('arco')*(1+.2*Math.ceil(st/2))*(1+.15*cnt('arco_dano'))}
function arcoUpd(dt,AS){const c=cnt('arco'),st=Math.max(0,c-3),ks=(1+.15*Math.floor(st/2))*(1+.1*cnt('arco_vel')),A=P.ar=P.ar||{t:0,n:0};
 if(P.mv)P.quieto=0;else P.quieto=(P.quieto||0)+dt;
 A.t-=dt;if(A.t>0)return;
 const a=aimA(560);if(a==null)return;P.fa=a;
 A.t=.55/ks/AS;A.n++;const n=1+cnt('arco_multi')+cnt('multig'),q=P.quieto||0,fm=1+.15*cnt('arco_firme')*Math.min(1,q/1.5),sniper=cnt('arco_leg')&&q>=2;
 if(sniper)P.quieto=0;const hook=cnt('arco_arpon')&&A.n%2==0;
 for(let i=0;i<n;i++){const aa=a+(i-(n-1)/2)*.12;S.sh.push({k:'ar',x:P.x,y:P.y,sx:P.x,sy:P.y,vx:Math.cos(aa)*720,vy:Math.sin(aa)*720,a:aa,t:0,h:new Set(),pc:sniper?99:1+cnt('arco_pierce'),fm,hook:hook&&i==0})}}
function arcoProj(s,dt){s.x+=s.vx*dt;s.y+=s.vy*dt;const rec=Math.hypot(s.x-s.sx,s.y-s.sy);if(rec>720||s.t>1.5){s.dead=1;return}
 for(const e of S.en){if(e.hp<=0||s.h.has(e)||Math.hypot(e.x-s.x,e.y-s.y)>=e.r+6)continue;s.h.add(e);
  hurt(e,arcoD()*s.fm*(1+.04*cnt('arco_alcance')*rec/100),'Arco');
  if(cnt('arco')>=3)marcar(e);
  if(s.hook&&e.ty!='part')e.hook=.3+.1*cnt('arco_arpon');
  s.pc--;if(s.pc<=0){s.dead=1;break}}}
function marcar(e){if(e.hp<=0)return;const m=S.marcado;if(m&&m!==e&&m.hp>0&&m.mk>0)return;e.mk=MARCA.dur;S.marcado=e}
function contagiarMarca(e){const t=nearAt(e.x,e.y,350);if(t&&t!==e){t.mk=e.mk;S.marcado=t}}

</script>
<script>
// ESCENARIO: suelo con textura, obstáculos y zonas (agua, manantiales) generados con una semilla distinta en cada partida.
// Las reglas de cada mapa están en datos/mapas.js (campos 'suelo' y 'escenario'). Los jefes ignoran obstáculos y zonas.
function rng(seed){let a=seed>>>0;return()=>{a=(a+0x6D2B79F5)>>>0;let t=a;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296}}
function entre(r,p){return p[0]+(p[1]-p[0])*r()}
function distObs(o,x,y){if(o.t=='rect')return Math.hypot(Math.max(Math.abs(x-o.x)-o.w/2,0),Math.max(Math.abs(y-o.y)-o.h/2,0));return Math.hypot(x-o.x,y-o.y)-o.R}
function escenario(){
 const M=MAPAS[S.w],E=M.escenario||{},r=rng(S.seed);S.obs=[];S.agua=[];
 const libre=(x,y,rad,m)=>{if(Math.hypot(x,y)<rad+280)return false;if(Math.abs(x)>AR.w-80-rad||Math.abs(y)>AR.h-80-rad)return false;
  for(const o of S.obs)if(distObs(o,x,y)<rad+m)return false;for(const a of S.agua)if(Math.hypot(x-a.x,y-a.y)<a.r+rad+30)return false;return true};
 for(const o of E.obstaculos||[]){const n=Math.round(entre(r,o.n));
